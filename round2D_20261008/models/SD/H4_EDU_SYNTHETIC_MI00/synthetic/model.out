INPUT INSTRUCTIONS

  TITLE:
  Round2D SD H4_EDU SYNTHETIC MI00 synthetic
  DATA:
  FILE = "data.dat";
  VARIABLE:
  NAMES = fid x1 x2 x3 x4 x5 y1 y2 y3 y4 y5 z1 z2 z3 z4 z5 z0 gedu gurb ginc c1 c2 c3 c4
    c5 c6 c7 c8 c9 c10 c11 c12 c13 c14 c15 c16 c17 c18 c19 c20 c21 c22 c23 c24;
   MISSING=.;
   CLUSTER=fid; USEVARIABLES=x1-x5 y1-y5 z0 c1-c3 zg;
  DEFINE:
  zg=z0*c2;
  ANALYSIS:
  TYPE=COMPLEX RANDOM; ESTIMATOR=MLR; PROCESSORS=1;
  ALGORITHM=INTEGRATION; INTEGRATION=MONTECARLO(500);
  MCSEED=26100803; COVERAGE=.005; ITERATIONS=2000; MITERATIONS=4000;
  MODEL:
  ix sx | x1@0 x2*0.4 x3*0.6 x4*0.8 x5@1 ;
  iy sy | y1@0 y2@0.4 y3@0.6 y4@0.8 y5@1 ;
  iy ON ix (bii);
  sy ON ix (bis);
  sy ON sx (bss);
  sy ON iy (bsyiy);
  ix WITH sx;
  ix sx iy sy ON c1-c3;
  sx WITH iy;
  x1 WITH y1;
  x2 WITH y2;
  x3 WITH y3;
  x4 WITH y4;
  x5 WITH y5;
  ix sx ON z0 zg;
  iy ON z0 (gi0);
  iy ON zg (gizg);
  sy ON z0 (gs0);
  sy ON zg (gszg);
  x1 y1 ON z0;
  sxz | sx XWITH z0;
  sxg | sx XWITH c2;
  sxzg | sx XWITH zg;
  sy ON sxz (dc);
  sy ON sxg (bxg);
  sy ON sxzg (dcg);
  OUTPUT:
  TECH1 TECH3 TECH8 CINTERVAL SVALUES;
  SAVEDATA:
  TECH3=tech3.dat; RESULTS=estimates.dat;



