  sy ON iz (gis);
  sy ON sz (gss);
  ix sx iz sz iy sy ON c1-c24;
  ix WITH sx iz sz;
  sx WITH iz sz;
  iz WITH sz;
  sx WITH iy;
  sz WITH iy;
  x1 WITH y1;
  x2 WITH y2;
  x3 WITH y3;
  x4 WITH y4;
  x5 WITH y5;
