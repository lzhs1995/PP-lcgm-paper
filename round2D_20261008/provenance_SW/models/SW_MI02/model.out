  ix sx | x1@0 x2*0.4 x3*0.6 x4*0.8 x5@1 ;
  iy sy | y1@0 y2@0.4 y3@0.6 y4@0.8 y5@1 ;
  iy ON ix (bii);
  sy ON ix (bis);
  sy ON sx (bss);
  sy ON iy (bsyiy);
  ix WITH sx;
  ix sx iy sy ON c1-c24;
  sx WITH iy;
  x1 WITH y1;
  x2 WITH y2;
  x3 WITH y3;
  x4 WITH y4;
  x5 WITH y5;
  OUTPUT:
  TECH1 TECH3 TECH4 SAMPSTAT RESIDUAL CINTERVAL;
  SAVEDATA:
  TECH3=tech3.dat; RESULTS=estimates.dat;



