INPUT INSTRUCTIONS

  TITLE:
  Class-1_pp_LGCA
  DATA:
  FILE = "pp_lgca_type14_4_r_step2_s_mod_s_MI_TICs.dat";
  TYPE = IMPUTATION;

  VARIABLE:
  NAMES = SEX12 EDU12 URBAN12 PROV12 CDN12 CDAR12 CDSC12 MINOR12 HUKOU12 PINC12
       PINC212 CORES12 HEAL12 MARR12 ECO12 HWC12 SAT12 ADL12 FINC12 FID WAVE WFDMS12
       WFDMS16 WFDMS18 WFDMS20 WFDMS22 WFDCS12 WFDCS16 WFDCS18 WFDCS20 WFDCS22
       WFDDS712 WFDDS716 WFDDS718 WFDDS720 WFDDS722 WFDDS912 WFDDS916 WFDDS918
       WFDDS920 WFDDS922 CES8SD12 CES8SD16 CES8SD18 CES8SD20 CES8SD22 AGEG12 AGEG16
       AGEG18 AGEG20 AGEG22 PROV122 PROV123 CDSC121 PINCM112 PINCM212 HEAL121 HEAL123
       ECO122 ECO123 HWC122 HWC123 PID I4 S4;
   MISSING=.;
   usevar =
    wfdms12 wfdms16 wfdms18 wfdms20 wfdms22
  !wfdcs12 wfdcs16 wfdcs18 wfdcs20 wfdcs22
  !wfdds712 wfdds716 wfdds718 wfdds720 wfdds722
  !wfdds912 wfdds916 wfdds918 wfdds920 wfdds922
  ces8sd12 ces8sd16 ces8sd18 ces8sd20 ces8sd22

  !!! time-invar
  sex12 edu12 urban12
  prov122 prov123
  cdn12 cdar12
  cdsc121
  minor12 wave

  !!! time-var
  ageg12 pinc12 pinc212 cores12 heal121 heal123
  marr12 eco122 eco123 hwc122 hwc123 hukou12 sat12 adl12 finc12
  !ageg14 pinc14 cores14 heal141 heal143
  !marr14 										
  !ageg16 pinc16 cores16 heal161 heal163
  !marr16 eco162 eco163 hwc162 hwc163
  !ageg18 pinc18 cores18 heal181 heal183
  !marr18 eco182 eco183 hwc182 hwc183
  !ageg20 pinc20 cores20 heal201 heal203
  !marr20 eco202 eco203 hwc202 hwc203
  !ageg22 pinc22 cores22 heal221 heal223
  !marr22 eco222 eco223 hwc222 hwc223

  I4 S4

  ;
  idvariable=pid;
  cluster=fid;
  DEFINE:
  STANDARDIZE I4 S4

  ANALYSIS:
  estimator = mlr;
  TYPE=COMPLEX;
  TYPE = RANDOM;
  !type = mixture;
  ALGORITHM=INTEGRATION;
  !INTEGRATION = MONTECARLO;
  !starts = 600 200;
  !starts = 20;
  !LRTBOOTSTRAP = 200;
  !processors = 10;
  coverage = 0.005;
  MODEL:

  i1 s1 | wfdms12@0 wfdms16*4 wfdms18*6 wfdms20*8 wfdms22@10;
  !i2 s2 | wfdcs12@0 wfdcs16*4 wfdcs18*6 wfdcs20*8 wfdcs22@10;
  !i3 s3 | wfdds712@0 wfdds716@4 wfdds718@6 wfdds720@8 wfdds722@10;
  !i4 s4 | wfdds912@0 wfdds916@4 wfdds918@6 wfdds920@8 wfdds922@10;
  i5 s5 | ces8sd12@0 ces8sd16*4 ces8sd18*6 ces8sd20*8 ces8sd22@10;

  !s5@0;
  ![i1](x_mean);
  !i1(x_var);

  ![s1](x_mean);
  !s1(x_var);

  ![i4](w_mean);
  !i4(w_var);

  [s4](w_mean);
  s4(w_var);

  !!! correlation among residual error terms of three indicators at each time point
  !wfdms12 wfdcs12 wfdds712 wfdds912 WITH wfdms12 wfdcs12 wfdds712 wfdds912;
  !wfdms16 wfdcs16 wfdds716 wfdds916 WITH wfdms16 wfdcs16 wfdds716 wfdds916;
  !wfdms18 wfdcs18 wfdds718 wfdds918 WITH wfdms18 wfdcs18 wfdds718 wfdds918;
  !wfdms20 wfdcs20 wfdds720 wfdds920 WITH wfdms20 wfdcs20 wfdds720 wfdds920;
  !wfdms22 wfdcs22 wfdds722 wfdds922 WITH wfdms22 wfdcs22 wfdds722 wfdds922;

  s1s4_int | s1 XWITH s4;

  !!! Focus: intercept of ces8sd regressed on intercept of wfd
  !i5 on i1 i4;
  i5 on i1(b1i);
  i5 on i4(b2i);

  !!! Focus: slope of ces8sd regressed on intercept of wfd
  !s5 on i1 i4 i5 s1 s4 s1s4_int;
  s5 on i5 i1 i4; !!! s4 was removed due to non-convergence
  s5 on s1 (b1s);
  s5 on s4 (b2s);
  s5 on s1s4_int (b3s);

  !!! control: for long trend
  ! time-invar
  i5 s5 on sex12 edu12 urban12 prov122 prov123;
  i5 s5 on cdn12 cdar12 cdsc121 minor12 wave ;

  ! time-var
  i5 s5 on ageg12 pinc12 pinc212 cores12 heal121 heal123;
  i5 s5 on marr12 hukou12 eco122 eco123 hwc122 hwc123 sat12 adl12 finc12;

  !!! control: for short trend
  ! coefficients were constrained to be equal over all waves
  !ces8sd12 on ageg12 pincm112 pincm212 cores12 heal121 heal123 (p1-p5);
  !ces8sd12 on marr12 hukou12 eco122 eco123 hwc122 hwc123 (p7-p12);

  !ces8sd14 on ageg14 pinc14 cores14 heal141 heal143 (p1-p5);
  !ces8sd14 on marr14 hukou14 (p7-p8);	

  !ces8sd16 on ageg16 pinc16 cores16 heal161 heal163 (p1-p5);
  !ces8sd16 on marr16 hukou16 eco162 eco163 hwc162 hwc163 (p7-p12);

  !ces8sd18 on ageg18 pinc18 cores18 heal181 heal183 (p1-p5);
  !ces8sd18 on marr18 hukou18 eco182 eco183 hwc182 hwc183 (p7-p12);

  !ces8sd20 on ageg20 pinc20 cores20 heal201 heal203 (p1-p5);
  !ces8sd20 on marr20 hukou20 eco202 eco203 hwc202 hwc203 (p7-p12);

  !ces8sd22 on ageg22 pinc22 cores22 heal221 heal223 (p1-p5);
  !ces8sd22 on marr22 hukou22 eco222 eco223 hwc222 hwc223 (p7-p12);

  !!! FIML for missing data
  !pincm112 pincm212 cdar12;

  MODEL CONSTRAINT:
  !!! i on i * i
  !NEW (wiii_min wiii_lo wiii_mod wiii_hi wiii_max);
  !wiii_min = b1i + b3i*(-11.2384118310966);
  !wiii_lo = b1i + b3i*(w_mean - sqrt(w_var));
  !wiii_mod = b1i + b3i*w_mean;
  !wiii_hi = b1i + b3i*(w_mean + sqrt(w_var));
  !wiii_max = b1i + b3i*(6.52200817091736);

  !!! s on i * i
  !NEW (wiis_min wiis_lo wiis_mod wiis_hi wiis_max);
  !wiis_min = b1s + b3s*(-9.05618182457857);
  !wiis_lo = b1s + b3s*(w_mean - sqrt(w_var));
  !wiis_mod = b1s + b3s*w_mean;
  !wiis_hi = b1s + b3s*(w_mean + sqrt(w_var));
  !wiis_max = b1s + b3s*(5.4896590589969);

  !!! s on i * s
  !NEW (wiss_min wiss_lo wiss_mod wiss_hi wiss_max);
  !wiss_min = b1s + b3s*(-9.05618182457857);
  !wiss_lo = b1s + b3s*(w_mean - sqrt(w_var));
  !wiss_mod = b1s + b3s*w_mean;
  !wiss_hi = b1s + b3s*(w_mean + sqrt(w_var));
  !wiss_max = b1s + b3s*(5.4896590589969);

  !!! s on s * i
  !NEW (wsis_min wsis_lo wsis_mod wsis_hi wsis_max);
  !wsis_min = b1s + b3s*(-9.05618182457857);
  !wsis_lo = b1s + b3s*(w_mean - sqrt(w_var));
  !wsis_mod = b1s + b3s*w_mean;
  !wsis_hi = b1s + b3s*(w_mean + sqrt(w_var));
  !wsis_max = b1s + b3s*(5.4896590589969);

  !!! s on s * s
  NEW (wsss_min wsss_lo wsss_mod wsss_hi wsss_max);
  wsss_min = b1s + b3s*(-9.05618182457857);
  wsss_lo = b1s + b3s*(w_mean - sqrt(w_var));
  wsss_mod = b1s + b3s*w_mean;
  wsss_hi = b1s + b3s*(w_mean + sqrt(w_var));
  wsss_max = b1s + b3s*(5.4896590589969);

  !*
  !!! range for x
  NEW (x_low x_high);
  x_low = x_mean - sqrt(x_var);
  x_high = x_mean + sqrt(x_var);

  !!! range for w
  NEW (w_low w_high);
  w_low = w_mean - sqrt(w_var);
  w_high = w_mean + sqrt(w_var);
  *!

  !*
  !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
  !!!!!! Simple-slope Plot 2 !!!!!!!!!!!!!!
  !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!

  !!! X as focal antecedent variable
  !!! (x-axis = xvalue, y = yvalue, legend = different level of moderator)
  !!! merit: the trend of y / different pattern of slope.
  !
  !    X_LOW    3.701      0.023    163.034      0.000
  !    X_HIGH   4.464      0.020    219.375      0.000
  !    W_LOW   -0.012      0.012     -1.004      0.315
  !    W_HIGH   0.372      0.018     20.350      0.000


  Loop(xvalue, 3.701, 4.464, 0.1);

  Plot(

    Pwiii_lo Pwiiimod Pwiii_hi
    Pwiis_lo Pwiismod Pwiis_hi
    Pwiss_lo Pwissmod Pwiss_hi
    Pwsis_lo Pwsismod Pwsis_hi
    Pwsss_lo Pwsssmod Pwsss_hi

  );

  !!! Direct effect(s) of Xm on Ym, conditional on Wm: (b1 + b3*W)X !!!
  ! b1 + b3*W

  Pwiii_lo = wiii_lo * xvalue;
  Pwiiimod = wiii_mod * xvalue;
  Pwiii_hi = wiii_hi * xvalue;

  Pwiis_lo = wiis_lo * xvalue;
  Pwiismod = wiis_mod * xvalue;
  Pwiis_hi = wiis_hi * xvalue;

  Pwiss_lo = wiss_lo * xvalue;
  Pwissmod = wiss_mod * xvalue;
  Pwiss_hi = wiss_hi * xvalue;

  Pwsis_lo = wsis_lo * xvalue;
  Pwsismod = wsis_mod * xvalue;
  Pwsis_hi = wsis_hi * xvalue;

  Pwsss_lo = wsss_lo * xvalue;
  Pwsssmod = wsss_mod * xvalue;
  Pwsss_hi = wsss_hi * xvalue;

  *!


  !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
  !!!!!! Johnson-Neyman Plot !!!!!!!!!!
  !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!

  !!! (x-axis = moderator, y-axis = slope of predictor)
  !!! merit: Johnson-neyman interval
  !!! note: Johnson-Neyman Plot is only applicable with Dummy coding, not Effect coding
  !
  !     min                max
  ! I4  -11.2384118310966    6.52200817091736
  ! S4  -9.05618182457857    5.4896590589969
  !

  !!! wvalue is range of I4
  !Loop (wvalue, -11.2384118310966, 6.52200817091736, 0.05);
  !!! wvalue is range of S4
  Loop (wvalue, -9.05618182457857, 5.4896590589969, 0.05);

  Plot (

    !JN_wiii
    !JN_wiis
    !JN_wiss
    !JN_wsis
    JN_wsss

  );

  !!! X as focal antecedent variable
  !!! Direct effect(s) of X on Y, conditional on W: (b1 + b3*W)X !!!

  !JN_wiii = b1i + b3i*wvalue; ! wvalue is range of I4
  !JN_wiis = b1s + b3s*wvalue; ! wvalue is range of I4
  !JN_wiss = b1s + b3s*wvalue; ! wvalue is range of S4
  !JN_wsis = b1s + b3s*wvalue; ! wvalue is range of I4
  JN_wsss = b1s + b3s*wvalue; ! wvalue is range of S4


  OUTPUT:
  tech1 tech4 tech10 tech11 tech14 sampstat patterns stdyx;
  SAVEDATA:
  FILE = pp_lgca_type14_4_r_step2_s_mod_s_MI_TICs_result.txt;
  !SAVE = CPROB;
  PLOT:
  type = plot3;



