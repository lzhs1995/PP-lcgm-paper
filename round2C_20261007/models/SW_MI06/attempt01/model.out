  iy ON ix (bii);
  sy ON ix (bis);
  sy ON sx (bss);
  sy ON iy (bsyiy);
  ix WITH sx;
  ix sx iy sy ON c1-c24;
  sx WITH iy;
  x1 WITH y1;
  x2 WITH y2;
  x3 WITH y3;
  x4 WITH y4;
  x5 WITH y5;
  OUTPUT:
  TECH1 TECH3 TECH4 SAMPSTAT RESIDUAL CINTERVAL;
